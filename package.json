{
  "name": "ascii-aquarium",
  "version": "1.0.0",
  "description": "Interactive autonomous ASCII aquarium — OBS Browser Source overlay + Twitch chat bot",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
